{
  "name": "@datapitfalls/bench",
  "version": "0.0.0",
  "private": true,
  "description": "A benchmark of analytics-agent memory on changing airline data.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjonesdataliteracy/datapitfalls-bench.git"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs && python3 data/tests/test_builder.py && python3 data/tests/test_scan_traps.py",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "check:evidence": "node scripts/check-evidence.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@datapitfalls/schemas": "^0.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "ajv": "^8.20.0",
    "datapitfalls": "^0.12.0",
    "eslint": "^8.57.1",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  },
  "bin": {
    "datapitfalls-bench": "dist/cli.js"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  }
}
